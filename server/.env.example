# Copy to .env and enter your actual settings for local development.
# .env is git-ignored. This example file is committed.
# On the deployed server, configure these in the hosting dashboard.

# Main database.
# Local example:
# postgresql://postgres:devpassword@localhost:5432/caa
# Hosted example:
# postgresql://user:pass@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/caa

# Separate disposable database for automated tests.
# Tests drop and recreate tables. Never use your main database here.
TEST_DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/caa_test

# Allowed client origins, separated by commas.
# Use scheme + host + port, without a path or trailing slash.
# GitHub Pages origin: https://teywyl.github.io
CORS_ORIGINS=http://localhost:5173

# Login session duration in hours.
SESSION_HOURS=12

# Use production on the deployed server.
NODE_ENV=development

# The server defaults to port 3000 locally.
# Let the hosting provider supply PORT during deployment.

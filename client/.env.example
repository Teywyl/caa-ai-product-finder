# Copy to .env for local development. .env is git-ignored.
#
# Every VITE_ value is included in the client build and is public.
# Never put passwords, API keys or database connection strings here.

# Express API address, without a trailing slash.
#
# Local development: leave empty to use the Vite /api proxy.
# Deployment: set VITE_API_BASE_URL in the GitHub Pages workflow
# to your deployed API address, such as https://your-api.onrender.com.
#
# The revised client uses the real API and has no demo mode.
VITE_API_BASE_URL=
